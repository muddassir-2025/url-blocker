<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Alarm-style todo reminders show a full-screen notification (peeks over
         the lock screen). Android 14+ requires this permission; it is a
         normal permission granted automatically by the system. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Subtle haptic tick on every dhikr count (normal permission, auto-granted). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Foreground media service: offline audio keeps playing (with
         notification controls) when the app is backgrounded / screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Todo reminders: re-schedule AlarmManager alarms after a reboot (the OS
         clears all alarms on boot). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Todo reminders: exact alarms for on-time notifications on Android 12+.
         The user is guided to grant this from the Todo editor when they pick
         the Alarm style; without it, reminders fall back to inexact timing. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Package visibility (Android 11+): the block overlay resolves the HOME
         intent to return the user to their launcher after a block. Without
         this <queries> declaration the resolution can return null on newer
         Android versions, so the overlay would stay stuck on screen. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Urlblocker">

        <!-- Main activity — the only activity. Icon always visible on home screen. -->
        <!-- Device Admin prevents uninstall. Password protects the Block tab. -->
        <!-- configChanges: rotation must NOT recreate the activity, otherwise the
             embedded video/live player would restart on every rotation. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.Urlblocker"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Block overlay activity - no history, no recents, full-screen theme.
             Theme.Urlblocker.Overlay uses alpha-only window animations: the
             default scale-based close animation is what makes some launchers
             play a "floating app icon" animation when the overlay exits to
             Home, so a pure fade is applied instead. -->
        <activity
            android:name=".ui.BlockOverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Urlblocker.Overlay"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- Quran Reminder hub: verse + Media + Live, opened from the widget.
             configChanges: rotation must NOT recreate the activity, otherwise
             the embedded video/live player would restart on every rotation. -->
        <activity
            android:name=".quran.ui.QuranVerseActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:label="@string/widget_quran_reminder_title"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.Urlblocker" />

        <!-- Quran Reminder home-screen widget -->
        <receiver
            android:name=".quran.widget.QuranReminderWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quran_reminder_widget_info" />
        </receiver>

        <!-- Accessibility Service -->
        <service
            android:name=".service.UrlBlockerService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/accessibility_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Offline-audio foreground playback service: owns the MediaPlayer
             so audio continues in the background, with a media notification
             (play/pause/stop + lock-screen controls via MediaSessionCompat). -->
        <service
            android:name=".media.download.AudioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Todo reminders: alarm fire + Complete/Snooze actions + boot
             rescheduling. Exported=false is fine — the alarms and actions are
             the app's own explicit intents, and BOOT_COMPLETED is a system
             broadcast. -->
        <receiver
            android:name=".todo.data.TodoReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Todo snooze picker: a dialog-styled activity opened by the
             reminder notification's Snooze action (10 / 30 / 60 min or custom). -->
        <activity
            android:name=".todo.ui.TodoSnoozeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Urlblocker.Dialog" />

        <!-- Todo ALARM screen: launched by the SYSTEM via the alarm
             notification's full-screen intent (the sanctioned alarm pattern —
             direct activity launch from a background alarm is blocked on
             Android 14+). Shows over the lock screen (API 27+ attrs; window
             flags in code cover the rest). singleInstance so concurrent
             alarms never stack. -->
        <activity
            android:name=".todo.ui.TodoAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Urlblocker.Alarm" />

        <!-- Todo ALARM ringtone service: foreground service that plays the
             looping alarm ringtone + vibration for a full minute (even in the
             background / screen off) for alarm-style todos. Starts from the
             reminder receiver when an exact alarm fires; the exact-alarm
             exemption permits the background foreground-service start. -->
        <service
            android:name=".todo.data.TodoAlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- FileProvider: lets the native share sheet receive the generated
             Progress Card image (a cache file) without any storage permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Device Admin Receiver (adds uninstall friction) -->
        <receiver
            android:name=".receiver.DeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
