<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle rounded box for the Phone Limit widget's duration field. App
     drawable only (no framework drawables) so every launcher can inflate it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0FFFFFFF" />
    <corners android:radius="6dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_ref" />
</shape>
