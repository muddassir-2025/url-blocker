<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Used by Device Admin to add uninstall friction (must deactivate before uninstall) -->
    <!-- Used by Device Owner (via ADB setup) to truly block uninstall via setUninstallBlocked() -->
    <uses-policies>
        <disable-uninstall />
    </uses-policies>
</device-admin>
