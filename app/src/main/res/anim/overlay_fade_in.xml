<?xml version="1.0" encoding="utf-8"?>
<!-- Alpha-only window enter animation for BlockOverlayActivity. Deliberately
     no scale/translation: a scale-based close animation is what makes some
     launchers play the "floating app icon" animation when the overlay leaves. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="150"
    android:fromAlpha="0.0"
    android:toAlpha="1.0" />
