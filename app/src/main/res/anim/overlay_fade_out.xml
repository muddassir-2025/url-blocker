<?xml version="1.0" encoding="utf-8"?>
<!-- Alpha-only window exit animation for BlockOverlayActivity. Fading out
     instead of scaling prevents the launcher from animating the app icon
     floating across the home screen when the overlay finishes. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="120"
    android:fromAlpha="1.0"
    android:toAlpha="0.0" />
